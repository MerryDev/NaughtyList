### Get all escalation policies
# @name getEscalationPolicies

GET {{baseUrl}}/escalation-policies
Authorization: Bearer {{$auth.token("server")}}

> {%
    client.test("Escalation policies are returned", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(Array.isArray(response.body), "Expected response array");
    });
%}

###

### Get escalation policy
# @name getEscalationPolicy

GET {{baseUrl}}/escalation-policies/{{escalationPolicyId}}
Authorization: Bearer {{$auth.token("server")}}

> {%
    client.test("Escalation policy is returned", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(
            String(response.body.id) === String(client.global.get("escalationPolicyId")),
            "Expected requested policy"
        );
    });
%}

###

### Get unknown escalation policy
# @name getUnknownEscalationPolicy

GET {{baseUrl}}/escalation-policies/{{missingId}}
Authorization: Bearer {{$auth.token("server")}}

> {%
    client.test("Unknown escalation policy is rejected", function () {
        client.assert(response.status === 404, "Expected HTTP 404");
        client.assert(
            response.body.detail === "Escalation policy not found",
            "Expected missing policy error"
        );
    });
%}

###

### Create escalation policy
# @name createEscalationPolicy

POST {{baseUrl}}/escalation-policies
Authorization: Bearer {{actorToken}}
Content-Type: application/json

{
  "key": "HTTP_ESCALATION_{{$random.uuid}}",
  "name": "HTTP Test Escalation Policy",
  "description": "Created by HTTP client"
}

> {%
    client.test("Escalation policy is created", function () {
        client.assert(response.status === 201, "Expected HTTP 201");
        client.assert(response.body.id != null, "Expected policy ID");
        client.assert(response.body.reasonId == null, "Expected global policy");
        client.assert(response.body.enabled === true, "Expected enabled policy");
    });

    client.global.set("escalationPolicyId", response.body.id);
%}

###

### Create escalation policy version
# @name createEscalationPolicyVersion

POST {{baseUrl}}/escalation-policies/{{escalationPolicyId}}/versions
Authorization: Bearer {{actorToken}}
Content-Type: application/json

{
  "lookback": "P30D",
  "steps": [
    {
      "minimumOffenses": 1,
      "type": "WARNING"
    },
    {
      "minimumOffenses": 2,
      "type": "MUTE",
      "duration": "P1D"
    }
  ]
}

> {%
    client.test("Escalation policy version is created", function () {
        client.assert(response.status === 201, "Expected HTTP 201");
        client.assert(response.body.version === 1, "Expected first version");
        client.assert(response.body.active === false, "Expected inactive version");
        client.assert(response.body.steps.length === 2, "Expected two steps");
        client.assert(
            response.body.steps[0].minimumOffenses === 1,
            "Expected first offense threshold"
        );
    });

    client.global.set("escalationVersionId", response.body.id);
%}

###

### Get created escalation policy version
# @name getEscalationPolicyVersion

GET {{baseUrl}}/escalation-policies/{{escalationPolicyId}}/versions/{{escalationVersionId}}
Authorization: Bearer {{$auth.token("server")}}

> {%
    client.test("Escalation policy version is returned", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(
            String(response.body.id) === String(client.global.get("escalationVersionId")),
            "Expected requested version"
        );
        client.assert(response.body.steps.length === 2, "Expected both steps");
    });
%}

###

### Get escalation policy versions
# @name getEscalationPolicyVersions

GET {{baseUrl}}/escalation-policies/{{escalationPolicyId}}/versions
Authorization: Bearer {{$auth.token("server")}}

> {%
    client.test("Created version appears in the list", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(Array.isArray(response.body), "Expected response array");
        client.assert(
            response.body.some(function (version) {
                return String(version.id) ===
                    String(client.global.get("escalationVersionId"));
            }),
            "Expected created version in the list"
        );
    });
%}

###

### Activate escalation policy version
# @name activateEscalationPolicyVersion

POST {{baseUrl}}/escalation-policies/{{escalationPolicyId}}/versions/{{escalationVersionId}}/activate
Authorization: Bearer {{actorToken}}

> {%
    client.test("Escalation policy version is active", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.active === true, "Expected active version");
        client.assert(
            String(response.body.id) === String(client.global.get("escalationVersionId")),
            "Expected requested version"
        );
    });
%}

###

### Create second escalation policy version
# @name createSecondEscalationPolicyVersion

POST {{baseUrl}}/escalation-policies/{{escalationPolicyId}}/versions
Authorization: Bearer {{actorToken}}
Content-Type: application/json

{
  "lookback": "P60D",
  "steps": [
    {
      "minimumOffenses": 1,
      "type": "WARNING"
    },
    {
      "minimumOffenses": 2,
      "type": "BAN",
      "duration": "P7D"
    }
  ]
}

> {%
    client.test("Second escalation policy version is created inactive", function () {
        client.assert(response.status === 201, "Expected HTTP 201");
        client.assert(response.body.version === 2, "Expected version 2");
        client.assert(response.body.active === false, "Expected inactive version");
    });

    client.global.set("secondEscalationVersionId", response.body.id);
%}

###

### Activate second escalation policy version
# @name activateSecondEscalationPolicyVersion

POST {{baseUrl}}/escalation-policies/{{escalationPolicyId}}/versions/{{secondEscalationVersionId}}/activate
Authorization: Bearer {{actorToken}}

> {%
    client.test("Second version is activated", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.active === true, "Expected active version");
    });
%}

###

### Verify active escalation policy version
# @name verifyActiveEscalationPolicyVersion

GET {{baseUrl}}/escalation-policies/{{escalationPolicyId}}/versions
Authorization: Bearer {{$auth.token("server")}}

> {%
    client.test("Only the second version is active", function () {
        client.assert(response.status === 200, "Expected HTTP 200");

        var active = response.body.filter(function (version) {
            return version.active === true;
        });
        client.assert(active.length === 1, "Expected exactly one active version");
        client.assert(
            String(active[0].id) === String(client.global.get("secondEscalationVersionId")),
            "Expected second version to be active"
        );
        client.assert(
            response.body.some(function (version) {
                return String(version.id) ===
                    String(client.global.get("escalationVersionId")) &&
                    version.active === false;
            }),
            "Expected first version to be inactive"
        );
    });
%}

###

### Activate version without permission
# @name activateEscalationPolicyVersionWithoutPermission

POST {{baseUrl}}/escalation-policies/{{escalationPolicyId}}/versions/{{secondEscalationVersionId}}/activate
Authorization: Bearer {{emptyActorToken}}

> {%
    client.test("Version activation requires escalation write permission", function () {
        client.assert(response.status === 403, "Expected HTTP 403");
    });
%}

###

### Update escalation policy details
# @name updateEscalationPolicyDetails

PATCH {{baseUrl}}/escalation-policies/{{escalationPolicyId}}
Authorization: Bearer {{actorToken}}
Content-Type: application/json

{
  "name": "Updated HTTP Escalation Policy",
  "description": null
}

> {%
    client.test("Policy details are updated", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(
            response.body.name === "Updated HTTP Escalation Policy",
            "Expected updated name"
        );
        client.assert(response.body.description == null, "Expected cleared description");
    });
%}