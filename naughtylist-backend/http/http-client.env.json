{
  "dev": {
    "baseUrl": "http://localhost:8080",
    "Security": {
      "Auth": {
        "server": {
          "Type": "OAuth2",
          "Grant Type": "Client Credentials",
          "Token URL": "{{baseUrl}}/api/v1/auth/token",
          "Client ID": "{{apiClientId}}",
          "Client Secret": "{{apiClientSecret}}",
          "Client Credentials": "in body"
        }
      }
    }
  }
}