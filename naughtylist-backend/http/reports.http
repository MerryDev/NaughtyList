### Create report for acceptance conflict
# @name createAcceptConflictReport

POST {{baseUrl}}/reports
Authorization: Bearer {{$auth.token("server")}}
Content-Type: application/json

{
  "reporterUuid": "{{testPlayerUuid}}",
  "targetUuid": "{{acceptConflictTargetUuid}}",
  "reasonId": {{reasonId}}
}

> {%
    client.global.set("reportId", response.body.id);
%}

###

### Accept report
# @name acceptReport

POST {{baseUrl}}/reports/{{reportId}}/accept
Authorization: Bearer {{actorToken}}

> {%
    client.test("Report is accepted", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.status === "ACCEPTED", "Expected ACCEPTED status");
        client.assert(response.body.caseId != null, "Expected report to have a case");
    });
%}

###

### Accept report with ambiguous cases
# @name acceptReportExpectingConflict

POST {{baseUrl}}/reports/{{reportId}}/accept
Authorization: Bearer {{actorToken}}

> {%
    client.test("Multiple open cases return 409", function () {
        client.assert(response.status === 409, "Expected HTTP 409");
    });
%}

###

### Close assigned report
# @name closeAssignedReport

POST {{baseUrl}}/reports/{{reportId}}/close
Authorization: Bearer {{actorToken}}

> {%
    client.test("Report is closed", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.status === "CLOSED", "Expected CLOSED status");
    });
%}