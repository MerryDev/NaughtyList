###

### Accept assigned report
# @name acceptAssignedReport

POST {{baseUrl}}/reports/{{assignedAcceptReportId}}/accept
Authorization: Bearer {{actorToken}}

> {%
    client.test("Assigned report is accepted", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.status === "ACCEPTED", "Expected ACCEPTED status");
        client.assert(response.body.caseId != null, "Expected report to have a case");
    });
%}

###

### Accept report with automatically resolved case
# @name acceptAutoReport

POST {{baseUrl}}/reports/{{autoAcceptReportId}}/accept
Authorization: Bearer {{actorToken}}

> {%
    client.test("Report is accepted with an automatically resolved case", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.status === "ACCEPTED", "Expected ACCEPTED status");
        client.assert(response.body.caseId != null, "Expected report to have a case");
    });
%}

###

### Accept report with ambiguous cases
# @name acceptReportExpectingConflict

POST {{baseUrl}}/reports/{{acceptConflictReportId}}/accept
Authorization: Bearer {{actorToken}}

> {%
    client.test("Multiple open cases return 409", function () {
        client.assert(response.status === 409, "Expected HTTP 409");
    });
%}

###

### Close investigation report
# @name closeInvestigationReport

POST {{baseUrl}}/reports/{{investigationReportId}}/close
Authorization: Bearer {{actorToken}}

> {%
    client.test("Report is closed", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.status === "CLOSED", "Expected CLOSED status");
    });
%}

###

### List reports by case
# @name getReportsByCase

GET {{baseUrl}}/reports?caseId={{investigationCaseId}}
Authorization: Bearer {{$auth.token("server")}}

> {%
    client.test("Reports are filtered by case", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(Array.isArray(response.body), "Expected response array");
        client.assert(response.body.length > 0, "Expected at least one report");

        const expectedCaseId = Number(client.global.get("investigationCaseId"));

        response.body.forEach(function (report) {
            client.assert(
                report.caseId === expectedCaseId,
                "Expected every report to belong to case " + expectedCaseId
            );
        });
    });
%}
