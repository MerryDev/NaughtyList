###

### Add empty case note
# @name addEmptyCaseNote

POST {{baseUrl}}/cases/{{investigationCaseId}}/notes
Authorization: Bearer {{actorToken}}
Content-Type: application/json

{
  "content": "   "
}

> {%
    client.test("Empty case note returns 400", function () {
        client.assert(response.status === 400, "Expected HTTP 400");
    });
%}

###

### Add empty case evidence
# @name addEmptyCaseEvidence

POST {{baseUrl}}/cases/{{investigationCaseId}}/evidence
Authorization: Bearer {{actorToken}}
Content-Type: application/json

{
  "type": "CHAT_LOG",
  "value": "   "
}

> {%
    client.test("Empty case evidence returns 400", function () {
        client.assert(response.status === 400, "Expected HTTP 400");
    });
%}

