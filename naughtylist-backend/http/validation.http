### Get unknown moderation case
# @name getUnknownCase

GET {{baseUrl}}/cases/{{missingId}}
Authorization: Bearer {{$auth.token("server")}}

> {%
    client.test("Unknown case returns 404", function () {
        client.assert(response.status === 404, "Expected HTTP 404");
    });
%}

###

### Get notes for unknown moderation case
# @name getUnknownCaseNotes

GET {{baseUrl}}/cases/{{missingId}}/notes
Authorization: Bearer {{$auth.token("server")}}

> {%
    client.test("Unknown case notes return 404", function () {
        client.assert(response.status === 404, "Expected HTTP 404");
    });
%}

